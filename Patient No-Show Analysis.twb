      <aliases enabled='yes' />
      <column caption='Appointment Day' datatype='date' name='[AppointmentDay]' role='dimension' type='ordinal' />
      <column caption='Appointment ID' datatype='integer' name='[AppointmentID]' role='dimension' type='ordinal' />
      <column caption='WaitingDays' datatype='integer' name='[Calculation_895090491743096833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [ScheduledDay], [AppointmentDay])' />
      </column>
      <column caption='NoShowBinary' datatype='integer' name='[Calculation_895090491743678466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [No-show] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_895090491744059395]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [AppointmentDay])' />
      </column>
      <column caption='AgeGroup' datatype='string' name='[Calculation_895090491744284676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 18 THEN &quot;0-17&quot;&#13;&#10;ELSEIF [Age] &lt; 30 THEN &quot;18-29&quot;&#13;&#10;ELSEIF [Age] &lt; 50 THEN &quot;30-49&quot;&#13;&#10;ELSEIF [Age] &lt; 70 THEN &quot;50-69&quot;&#13;&#10;ELSE &quot;70+&quot;&#13;&#10;END' />
      </column>
